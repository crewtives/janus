{
  "name": "janus",
  "version": "0.2.4",
  "description": "The personal historian for makers — nightly agent that reads git + Claude Code sessions and writes a continuous narrative into Obsidian.",
  "type": "module",
  "license": "MIT",
  "author": "Crewtives",
  "homepage": "https://github.com/crewtives/janus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewtives/janus.git"
  },
  "bugs": {
    "url": "https://github.com/crewtives/janus/issues"
  },
  "keywords": [
    "agent",
    "claude-code",
    "obsidian",
    "mcp",
    "personal-historian",
    "git",
    "bun",
    "narrative",
    "journaling"
  ],
  "bin": {
    "janus": "./bin/janus.ts"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/install.sh",
    "scripts/install-binary.sh",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run bin/janus.ts",
    "pulse": "bun run bin/janus.ts pulse",
    "doctor": "bun run bin/janus.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build bin/janus.ts --compile --outfile dist/janus"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "citty": "^0.2.2",
    "eta": "^4.6.0",
    "p-queue": "^9.3.0",
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
